{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jandrea-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
      "observability": {
                 

                

                      "enabled": true
                 

                

                    },
  // Cloudflare Email Service: avisos de nuevas solicitudes de proforma (routes/leads.tsx).
  // El dominio jandrea.art debe estar dado de alta en Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "contacto@jandrea.art"
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
 "r2_buckets": [
  {
    "binding": "MY_BUCKET",
    "bucket_name": "jandrea-images",
    "preview_bucket_name": "jandrea-images"
  },
  {
    "binding": "RECEIPTS_BUCKET",
    "bucket_name": "jandrea-receipts",
    "preview_bucket_name": "jandrea-receipts"
  }
],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jandrea",
      "database_id": "fef1843a-7621-483a-81ad-f575f05229fe"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
